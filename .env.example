# Local dev defaults match docker-compose.yml. For Supabase, use the pooled
# connection string with the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://homelab:homelab@localhost:5432/homelab
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Auth (used from milestone 2). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Base URL of the frontend; verification emails link to {FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:5173

# Email. "console" logs messages instead of sending (local dev); "smtp" sends for real
# (e.g. Resend, Postmark, SES, or Gmail with an app password).
EMAIL_BACKEND=console
EMAIL_FROM=Homelab Parts Finder <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# eBay Browse API (used by the ingestion worker).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Best Buy Products API (US catalog; free key at https://developer.bestbuy.com/).
# The ingestion worker skips Best Buy when this is empty.
BESTBUY_API_KEY=
